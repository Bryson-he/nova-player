{
  "name": "nova-player",
  "productName": "Nova Player",
  "version": "2.0.0-beta.1",
  "description": "A fast, modern Jellyfin client for Windows",
  "author": "Bryson",
  "license": "MIT",
  "homepage": "https://github.com/Bryson-he/nova-player",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bryson-he/nova-player.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/build-preload.js && electron .",
    "postinstall": "node scripts/copy-vendor.js && node scripts/build-preload.js",
    "dist": "node scripts/build-preload.js && electron-builder --win nsis portable --publish never",
    "pack": "node scripts/build-preload.js && electron-builder --win dir",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write src/main test scripts",
    "icons": "node scripts/build-icons.js"
  },
  "build": {
    "appId": "com.nova.jellyfinplayer",
    "productName": "Nova Player",
    "files": [
      "src/**/*",
      "!src/renderer/js/nova.d.ts",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bryson-he",
        "repo": "nova-player"
      }
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "NovaPlayer-Setup.exe"
    },
    "portable": {
      "artifactName": "NovaPlayer-Portable.exe"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@resvg/resvg-js": "2.6.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "hls.js": "^1.7.4",
    "jassub": "^2.5.37",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
