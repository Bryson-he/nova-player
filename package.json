{
  "name": "nova-player",
  "productName": "Nova Player",
  "version": "1.3.0",
  "description": "A fast, modern Jellyfin client for Windows",
  "author": "Bryson",
  "license": "MIT",
  "homepage": "https://github.com/Bryson-he/nova-player",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bryson-he/nova-player.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/build-preload.js && electron .",
    "postinstall": "node scripts/copy-vendor.js && node scripts/build-preload.js",
    "dist": "node scripts/build-preload.js && electron-builder --win nsis portable --publish never",
    "release": "node scripts/build-preload.js && electron-builder --win nsis portable --publish always",
    "pack": "node scripts/build-preload.js && electron-builder --win dir"
  },
  "build": {
    "appId": "com.nova.jellyfinplayer",
    "productName": "Nova Player",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bryson-he",
        "repo": "nova-player",
        "releaseType": "draft"
      }
    ],
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "NovaPlayer-Setup.exe"
    },
    "portable": {
      "artifactName": "NovaPlayer-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.3",
    "jassub": "^2.5.23"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
